rules_version = '2';

// Aucune donnée métier n'est lue ou écrite directement par le client Firestore.
// Toutes les lectures et écritures passent par le serveur Next.js (SDK Admin),
// qui applique les droits par objet (spec §13). Ce verrou empêche toute
// fuite par un accès Firestore direct, même si l'interface change.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
