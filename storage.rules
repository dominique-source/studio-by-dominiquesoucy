rules_version = '2';

// Stockage privé (sources audio/texte, V1.5+) : aucun accès direct client.
// Les lectures/écritures passeront par le serveur (URLs signées émises après
// vérification des droits), jamais par des règles Storage permissives.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
